# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
APP_NAME=NestJS Boilerplate
API_PREFIX=api/v1
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DOCS_ENABLED=true
DOCS_PATH=docs

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_boilerplate
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_POOL_MAX=10

# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Use cookie-based refresh tokens (true/false)
REFRESH_TOKEN_COOKIE=true
REFRESH_TOKEN_COOKIE_NAME=rt
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# Rate Limiting
# =============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug