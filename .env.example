# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
APP_NAME=nestjs-boilerplate
PORT=3000
HOST=0.0.0.0

# API versioning
API_PREFIX=api
API_VERSION=v1

# CORS — comma-separated origins. Use * to allow any (not recommended with credentials).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=false

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://app:app@localhost:5432/app_db?schema=public
DATABASE_LOG_LEVEL=warn
DATABASE_POOL_SIZE=10

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug
LOG_PRETTY=true

# =============================================================================
# Security / Rate limiting
# =============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# =============================================================================
# JWT / Auth
# =============================================================================
# Use at least 32 random bytes in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-secure-secret-at-least-32-bytes-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-secure-secret-also-32-bytes
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Swagger / OpenAPI
# =============================================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=NestJS Boilerplate API
SWAGGER_DESCRIPTION=Professional NestJS backend boilerplate
SWAGGER_VERSION=1.0.0
