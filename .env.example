# ============================================================================
# Application
# ============================================================================
APP_ENV=development
APP_NAME=sinatra_boilerplate
APP_HOST=0.0.0.0
APP_PORT=4567
APP_LOG_LEVEL=info
APP_VERSION=1.0.0

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sinatra_boilerplate_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL=10
DATABASE_TIMEOUT=5000

# Test database (used by RSpec)
DATABASE_NAME_TEST=sinatra_boilerplate_test

# ============================================================================
# Auth (JWT)
# ============================================================================
# Use `openssl rand -hex 64` to generate strong secrets in production
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
JWT_ISSUER=sinatra_boilerplate
JWT_AUDIENCE=sinatra_boilerplate_api

# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of allowed origins. Use "*" only in development.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Request-Id
CORS_MAX_AGE=86400

# ============================================================================
# Rate Limiting (rack-attack)
# ============================================================================
RATE_LIMIT=100
RATE_PERIOD=60

# ============================================================================
# Logging
# ============================================================================
LOG_DIR=./log
LOG_FILE=development.log