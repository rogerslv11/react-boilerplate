strict-peer-dependencies=false
auto-install-peers=true

# Allow native dependencies to run build scripts during install.
# Without this, pnpm refuses to build native modules (argon2, @parcel/watcher, ...).
allow-builds[@parcel/watcher]=true
allow-builds[argon2]=true
allow-builds[unrs-resolver]=true
allow-builds[@scarf/scarf]=true